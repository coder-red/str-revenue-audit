# Secrets — never commit
.env
.env.*
!.env.example

# Data (Inside Airbnb snapshots) — too big for git.
# Exceptions: Austin's listings.csv.gz (deploys work out of the box) and the
# committed redacted demo seed.
data/*
data/austin-2026-09-17/*
!data/austin-2026-09-17/listings.csv.gz
!data/lead_seed.parquet

# Generated reports / comps outputs
outputs/*
!outputs/.gitkeep

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Copy to .env and fill in values. .env is gitignored ??? never commit it.
# Phase 2 only: free-tier LLM keys. Leave blank to use only the non-LLM parts.

# Gemini (Google AI Studio free tier) ??? https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq (free tier) ??? https://console.groq.com/keys
GROQ_API_KEY=

# Which provider to use for the audit summary: gemini or groq
LLM_PROVIDER=gemini

# Optional model overrides
GEMINI_MODEL=gemini-2.5-flash
GROQ_MODEL=openai/gpt-oss-120b

# Phase 4 (lead finder): sender identity for the outreach drafts. CAN-SPAM requires
# a real identity and a physical postal address in every commercial email. Drafts
# are flagged not-sendable until these are set (the review UI and the CSV export both say so).
SENDER_NAME=
SENDER_BUSINESS=
SENDER_POSTAL_ADDRESS=
# Optional; a default opt-out line is used when unset.
OPT_OUT_TEXT=
